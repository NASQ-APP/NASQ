{
  "manifest_version": 3,
  "name": "دولابي الذكي — إضافة إلى دولابي",
  "description": "زر «إضافة إلى دولابي» داخل صفحة المنتج في المتاجر، يرسل القطعة إلى «قطع تحت التجربة».",
  "version": "0.1.0",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "دولابي الذكي"
  },
  "content_scripts": [
    {
      "js": ["content/store.js"],
      "run_at": "document_idle",
      "matches": [
        "*://*.shein.com/*",
        "*://*.namshi.com/*",
        "*://*.aliexpress.com/*",
        "*://*.zara.com/*",
        "*://*.noon.com/*",
        "*://*.asos.com/*",
        "*://*.vogacloset.com/*"
      ]
    },
    {
      "js": ["content/pinterest.js"],
      "run_at": "document_idle",
      "matches": ["*://*.pinterest.com/*"]
    },
    {
      "js": ["content/dulabi.js"],
      "run_at": "document_idle",
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"]
    }
  ]
}
