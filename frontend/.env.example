# ---------------------------------------------------------------------------
# نَسّق — إعدادات الفرونت-إند
#
# هذا **قالب فقط** — Vite ما يقرأه. انسخيه باسم `.env` وعبّي القيم، أو خذي
# ملف `.env` جاهزًا من صاحبة المشروع.
#
# قاعدة أمنية (§17): هنا `anon key` فقط.
# مفتاح service_role ومفاتيح مزوّدي الذكاء ما تنزل الفرونت-إند أبدًا —
# مكانها في متغيّرات الباك-إند داخل Edge Functions.
# ---------------------------------------------------------------------------

# الطقس: open-meteo (خدمة مفتوحة بلا مفتاح) أو off لإطفاء الميزة
VITE_WEATHER_PROVIDER=open-meteo

# عنوان دوال الحافة — يشير لمشروع Supabase أو للخادم المحلي
# مثال: https://<project-ref>.supabase.co/functions/v1
VITE_API_BASE=

# ---------------------------------------------------------------------------
# مشروع Supabase — مشترك بين الفريق
#
# القيم **ما تُكتب هنا**: هذا الملف مرفوع على git، والمفتاح يخصّ مشروعًا
# واحدًا يشترك فيه الفريق. اطلبي ملف `.env` جاهزًا من صاحبة المشروع.
#
# وبدون هذي القيم يرجع التطبيق للوضع المحلي: بلا حساب، وبلا مزامنة، وبلا
# استيراد من المتاجر — وكل وحدة تشوف متصفّحها وحده.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# التجربة الافتراضية — نموذج أولي محلي فقط
#
# **يبقى فاضيًا هنا عمدًا.** هذا مفتاح مدفوع مربوط برصيد حقيقي، ويُخبز في حزمة
# البناء فيقرأه أي أحد. كل وحدة تجيب مفتاحها من openrouter.ai وتحطّه في `.env`
# المحلي عندها — وما يُرفع أبدًا.
#
# عند النشر ينتقل النداء خلف خادم ويصير المفتاح في بيئته لا هنا.
# ---------------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# ---------------------------------------------------------------------------
# الستايليست — الوكيل
# ---------------------------------------------------------------------------

# مين يجاوب: local (قواعد حتمية) أو backend (نموذج حقيقي)
VITE_STYLIST_PROVIDER=backend

# عنوان الوكيل وحده — وسيط خادم التطوير. بقية الدوال تبقى على Supabase.
VITE_AGENT_BASE=/__dev

# ---------------------------------------------------------------------------
# مفاتيح النموذج — تُقرأ في خادم التطوير (Node) ولا تنزل المتصفح أبدًا.
# بلا بادئة VITE_ عن قصد: Vite ما يحزم إلا المسبوق بها، فهذي تبقى على الجهاز.
# ---------------------------------------------------------------------------

# مع Groq (طبقة مجانية):
AGENT_API_BASE=https://api.groq.com/openai/v1
AGENT_MODEL=llama-3.3-70b-versatile
AGENT_API_KEY=
