# ---------------------------------------------------------------------------
# دولابي الذكي — إعدادات الفرونت-إند
# انسخي هذا الملف باسم .env.local وعبّي القيم.
#
# قاعدة أمنية (§17): هنا `anon key` فقط.
# مفتاح service_role ومفاتيح مزوّدي الذكاء ما تنزل الفرونت-إند أبدًا —
# مكانها في متغيّرات الباك-إند داخل Edge Functions.
# ---------------------------------------------------------------------------

# مزوّد التجربة الافتراضية: local (تركيب محلي) أو backend (توليد حقيقي)
VITE_TRYON_PROVIDER=local

# الطقس: open-meteo (خدمة مفتوحة بلا مفتاح) أو off لإطفاء الميزة
VITE_WEATHER_PROVIDER=open-meteo

# عنوان دوال الحافة — يشير لمشروع Supabase أو للخادم المحلي
VITE_API_BASE=http://127.0.0.1:54321/functions/v1

# مشروع Supabase (المرحلة ١)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
