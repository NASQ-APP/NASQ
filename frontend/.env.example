# ---------------------------------------------------------------------------
# نَسّق — إعدادات الفرونت-إند
#
# انسخي هذا الملف باسم `.env` وخلاص — مفاتيح Supabase معبّأة أصلًا:
#
#   cp frontend/.env.example frontend/.env
#
# قاعدة أمنية (§17): هنا `anon key` فقط.
# مفتاح service_role ومفاتيح مزوّدي الذكاء ما تنزل الفرونت-إند أبدًا —
# مكانها في متغيّرات الباك-إند داخل Edge Functions.
# ---------------------------------------------------------------------------

# الطقس: open-meteo (خدمة مفتوحة بلا مفتاح) أو off لإطفاء الميزة
VITE_WEATHER_PROVIDER=open-meteo

# عنوان دوال الحافة — يشير لمشروع Supabase أو للخادم المحلي
VITE_API_BASE=https://vfkmydsarlznevuqibrn.supabase.co/functions/v1

# ---------------------------------------------------------------------------
# مشروع Supabase — مشترك بين الفريق
#
# مفتاح `anon` **مصمَّم ليكون عامًا**: يُخبز في حزمة البناء المنشورة، وأي أحد
# يفتح الموقع يقرأه من مصدر الصفحة. الحماية في RLS على القاعدة لا في إخفائه —
# كل جدول مقفول على `auth.uid()`، فما تقرأ مستخدمة صفوف غيرها.
#
# وضعناه هنا لأن المستودع **خاص**، فالسحب يكفي بلا إرسال يدوي ينُسى.
#
# ⚠️ لو صار المستودع عامًا: انقلي المفتاح من هنا وأرسليه بقناة خاصة. ما أحد
# يقدر يقرأ بيانات أحد، لكن يقدر أي أحد ينشئ حسابات ويستهلك حصّة المشروع.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://vfkmydsarlznevuqibrn.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZma215ZHNhcmx6bmV2dXFpYnJuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc3MzA3ODIsImV4cCI6MjEwMzMwNjc4Mn0.fk7cWfGgVDNCjCJ_xK51wFlmqwfSFuzJvQzfcXpb93Y

# ---------------------------------------------------------------------------
# التجربة الافتراضية — نموذج أولي محلي فقط
#
# **يبقى فاضيًا هنا عمدًا.** هذا مفتاح مدفوع مربوط برصيد حقيقي، ويُخبز في حزمة
# البناء فيقرأه أي أحد. كل وحدة تجيب مفتاحها من openrouter.ai وتحطّه في `.env`
# المحلي عندها — وما يُرفع أبدًا.
#
# عند النشر ينتقل النداء خلف خادم ويصير المفتاح في بيئته لا هنا.
# ---------------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
