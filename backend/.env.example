# ---------------------------------------------------------------------------
# دولابي الذكي — أسرار الباك-إند
#
# هذي القيم تعيش في الخادم فقط. ولا واحدة منها تنزل الفرونت-إند أبدًا (§17).
# محليًا: انسخي الملف باسم .env داخل supabase/
# على السحابة: supabase secrets set --env-file .env
# ---------------------------------------------------------------------------

# يُحقنان تلقائيًا في بيئة الدوال — ما تحتاجين تعبّينهما محليًا
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# أصل التطبيق المسموح له بالنداء (CORS)
APP_ORIGIN=http://localhost:5188
APP_NAME=دولابي الذكي

# إزالة الخلفية تشتغل محليًا في المتصفح بلا مفتاح.
# هذي للحالة اللي تبين فيها جودة أعلى لخلفيات مزدحمة.
# المزوّد المدعوم حاليًا: remove-bg
BACKGROUND_REMOVAL_PROVIDER=
BACKGROUND_REMOVAL_API_KEY=
# سقف طلبات إزالة الخلفية لكل مستخدمة في الدقيقة
BACKGROUND_REMOVAL_PER_MINUTE=12

# مزوّد الرؤية لتعبئة حقول القطعة من صورتها (A-07)
# المزوّد المدعوم حاليًا: openai-compatible
VISION_PROVIDER=
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
VISION_PER_MINUTE=20

# مزوّد التمثيل للبحث الدلالي (المرحلة ٤)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# مزوّد الوكيل (المرحلة ٤)
AGENT_PROVIDER=
AGENT_API_KEY=

# تسجيل الدخول بجوجل (اختياري)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
