# ---------------------------------------------------------------------------
# دولابي الذكي — أسرار الباك-إند
#
# هذي القيم تعيش في الخادم فقط. ولا واحدة منها تنزل الفرونت-إند أبدًا (§17).
# محليًا: انسخي الملف باسم .env داخل supabase/
# على السحابة: supabase secrets set --env-file .env
# ---------------------------------------------------------------------------

# يُحقنان تلقائيًا في بيئة الدوال — ما تحتاجين تعبّينهما محليًا
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# أصل التطبيق المسموح له بالنداء (CORS)
APP_ORIGIN=http://localhost:5188
APP_NAME=دولابي الذكي

# مزوّد التوليد (المرحلة ٣) — الاسم ثم مفتاحه
TRYON_PROVIDER=
TRYON_API_KEY=

# مزوّد الرؤية للتصنيف التلقائي وإزالة الخلفية (المرحلة ٢)
VISION_PROVIDER=
VISION_API_KEY=

# مزوّد التمثيل للبحث الدلالي (المرحلة ٤)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# مزوّد الوكيل (المرحلة ٤)
AGENT_PROVIDER=
AGENT_API_KEY=

# سقف التوليد اليومي لكل مستخدمة (S-09)
DAILY_RENDER_LIMIT=20

# تسجيل الدخول بجوجل (اختياري)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
