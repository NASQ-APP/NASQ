{
  "manifest_version": 3,
  "name": "بنترست → قطع تحت التجربة",
  "description": "زر «أضيفيها لقطع التجربة» داخل صفحة Pin، يرسل القطعة إلى التطبيق.",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "دولابي"
  },
  "content_scripts": [
    {
      "js": [
        "content/pinterest.js"
      ],
      "run_at": "document_idle",
      "matches": [
        "*://*.pinterest.com/*"
      ]
    },
    {
      "js": [
        "content/dulabi.js"
      ],
      "run_at": "document_idle",
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ]
    }
  ]
}
